# =============================================================================
# Travel Tracker - Variáveis de ambiente (copie este arquivo para ".env")
# =============================================================================

# --- Aplicação ---
APP_NAME=Travel Tracker
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_DIR=logs
EXPORT_DIR=exports
DATABASE_URL=sqlite:///travel_tracker.db

# --- Origens monitoradas (códigos IATA separados por vírgula) ---
ORIGINS=LDB,CWB,GRU,CGH,VCP

# --- Destinos ---
# Deixe em branco para pesquisar a lista curada de destinos (ver config/constants.py).
# Ou informe uma lista personalizada separada por vírgula, ex: SCL,EZE,LIS,MIA
CUSTOM_DESTINATIONS=
FAVORITE_DESTINATIONS=SCL,LIS,MIA

# --- Companhias preferidas (opcional, códigos IATA separados por vírgula) ---
PREFERRED_AIRLINES=

# --- Regras de pesquisa e promoção ---
MAX_PRICE=
MONITORED_DAYS=2,3,4,5,7,10,15,30
MIN_ADVANCE_DAYS=30
MAX_ADVANCE_DAYS=365
DATE_STEP_DAYS=7
DISCOUNT_THRESHOLD_PERCENT=15
MIN_HISTORY_FOR_AVERAGE=3

# --- Provedores de dados ---
# O provedor "mock" gera dados realistas e permite usar o sistema sem nenhuma chave de API.
USE_MOCK_PROVIDER=true
# Scrapers experimentais (sites sem API oficial) ficam DESLIGADOS por padrão.
# Leia o README antes de habilitar - muitos sites proíbem scraping em seus Termos de Uso.
ENABLE_EXPERIMENTAL_SCRAPERS=false

# --- Amadeus for Developers (API oficial de voos) ---
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# --- Travelpayouts / Aviasales Data API (API oficial de dados de preços) ---
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord (Webhook) ---
DISCORD_WEBHOOK_URL=

# --- E-mail (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TO_EMAIL=
SMTP_USE_TLS=true

# --- Notificação Desktop ---
DESKTOP_NOTIFICATIONS_ENABLED=true

# --- Performance ---
SEARCH_INTERVAL_HOURS=6
MAX_CONCURRENT_REQUESTS=5
MAX_SEARCHES_PER_RUN=200
REQUEST_TIMEOUT_SECONDS=20
CACHE_TTL_SECONDS=3600
REQUESTS_PER_SECOND=2

# --- Diversos ---
DEFAULT_CURRENCY=BRL
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
