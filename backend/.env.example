# Configuracoes do backend do Python Hub.
# Copie este arquivo para ".env" e ajuste conforme necessario.
# Este arquivo NUNCA deve conter segredos dos seus sistemas Python -
# cada sistema tem seu proprio .env dentro de systems/<id>/.

# Origens permitidas para CORS (separadas por virgula).
PH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host/porta do servidor Uvicorn.
PH_HOST=0.0.0.0
PH_PORT=8000
